# InvestAnalyzer - konfiguracja lokalna
#
# Aplikacja dziala w calosci na tym komputerze. Nie wysyla plikow brokera,
# danych transakcyjnych ani wynikow rozliczenia do zadnej uslugi zewnetrznej
# i nie wymaga zadnego klucza API. Wszystkie ponizsze zmienne sa opcjonalne -
# domyslne wartosci wystarczaja do normalnej pracy.

# --- Serwer deweloperski (tylko tryb web/dev; wersja desktop go nie uruchamia) ---

# Port serwera deweloperskiego.
# PORT=3000

# Interfejs nasluchu. Domyslnie petla zwrotna, celowo bez wystawiania na siec.
# HOST=127.0.0.1

# Ustaw na "false", zeby wylaczyc hot reload przy pracy z agentem.
# ENABLE_HMR=true

# --- Lokalny model jezykowy (Ollama) ---
#
# Uzywany wylacznie do rozpoznawania dokumentow i mapowania kolumn.
# Silnik podatkowy liczy deterministycznie i nie korzysta z modelu.
# Adres musi wskazywac petle zwrotna - polaczenia zdalne sa blokowane.

# INVEST_OLLAMA_BASE_URL=http://127.0.0.1:11434
# INVEST_OLLAMA_MODEL=qwen2.5:7b
# INVEST_OLLAMA_EXE_PATH=%LOCALAPPDATA%\Programs\OllamaCLI\ollama.exe
# INVEST_OLLAMA_TIMEOUT_SECONDS=120

# Zezwolenie na automatyczny start procesu Ollama przez aplikacje.
# INVEST_OLLAMA_ALLOW_AUTO_START=false

# Zezwolenie na prace modelu na CPU, gdy GPU jest niedostepne.
# INVEST_OLLAMA_ALLOW_CPU_AI=false

# --- Silnik podatkowy ---

# "minimal" pomija generowanie skoroszytu XLSX i przyspiesza przebieg.
# Nie zmienia wynikow ani sumy kontrolnej audytu.
# INVEST_TAX_EXPORT_MODE=full

# Sciezka do starszego katalogu storage na potrzeby jednorazowej migracji.
# INVEST_ANALYZER_LEGACY_STORAGE=
