{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvestAnalyzer",
  "version": "0.2.0",
  "identifier": "com.investanalyzer.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../.."
    },
    "frontendDist": "../../../wydania/web",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InvestAnalyzer",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc:; object-src 'none'; frame-src 'none'; base-uri 'self';",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://localhost:* ws://localhost:*; object-src 'none'; frame-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["binaries/investment-tax-engine"],
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
